{% extends "base.twig" %}
{% block title %}
    Aktuality
{% endblock %}


{% block body %}
    <div class="container p-4">
        <nav class="d-flex justify-content-end">
            {% if isLoggedIn %}
                <a href="/admin" class="link-primary">Administrace</a>
            {% else %}
                <a href="/admin/login" class="link-primary">Přihlásit</a>
            {% endif %}
        </nav>
        <h1 class="text-center mb-5">Aktuality</h1>
        {% if articles %}
         
            {% for article in articles %}
                <article class="public-article d-block bg-white rounded-3 shadow p-4 mb-4">
                    <div class="text-muted">
                        {{ article.published_from }}
                    </div>
                    <h2>{{ article.title }}</h2>

                    <div>
                        {{ article.content|raw }}
                    </div>


                </article>
            {% endfor %}
        {% else %}
            <div class="text-center w-full">Omlouváme se, aktuality momentálně nejsou k dispozici</div>
        {% endif %}
        {% include "pagination.twig" %}
    </div>



{% endblock %}
