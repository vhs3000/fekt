{% extends "base.twig" %}
{% block title %}
    Aktuality
{% endblock %}


{% block body %}

    <a href="/admin">Administrace</a>
    <h1>Články</h1>

    {% for article in articles %}
        <article>
            <h2>{{ article.title }}</h2>

            <div>
                {{ article.content|raw }}
            </div>

            <p>
                Platí od: {{ article.published_from }}

                {% if article.published_to %}
                    <br>
                    Platí do: {{ article.published_to }}
                {% endif %}
            </p>
        </article>
    {% endfor %}


    {% include "pagination.twig" %}




{% endblock %}
