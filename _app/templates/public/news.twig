{% extends "base.twig" %}
{% block title %}
    Aktuality
{% endblock %}


{% block body %}
    <div class="container p-4">
        <nav class="d-flex justify-content-end">
            {% if isLoggedIn %}
                <a href="/admin" class="link-primary">Administrace</a>
            {% else %}
                <a href="/admin/login" class="link-primary">Přihlásit</a>
            {% endif %}
        </nav>
        <h1 class="text-center mb-5">Aktuality</h1>

        {% for article in articles %}
            <article class="d-block bg-white rounded-3 shadow p-4 mb-4">
                <div class="text-muted">
                    {{ article.published_from }}
                </div>
                <h2>{{ article.title }}</h2>

                <div>
                    {{ article.content|raw }}
                </div>


            </article>
        {% endfor %}


        {% include "pagination.twig" %}
    </div>



{% endblock %}
