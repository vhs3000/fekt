<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <title>Články</title>
</head>
<body>

    <h1>Články</h1>

    {% for article in articles %}
        <article>
            <h2>{{ article.title }}</h2>

            <div>
                {{ article.content|raw }}
            </div>

            <p>
                Platí od: {{ article.published_from }}

                {% if article.published_to %}
                    <br>
                    Platí do: {{ article.published_to }}
                {% endif %}
            </p>
        </article>
    {% endfor %}

</body>
</html>