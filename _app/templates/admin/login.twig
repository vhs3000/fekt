<!DOCTYPE html>
<html lang="cs">
   <head>
      <meta charset="UTF-8">
      <title>Přihlášení</title>
   </head>
   <body>

      <h1>Přihlášení</h1>
      {% if error %}
         <p>{{ error }}</p>
      {% endif %}
      <form method="post" action="/admin/login">

         <div>
            <label for="username">Login</label>
            <input
               type="text"
               id="username"
               name="username"
               required
            >
         </div>

         <div>
            <label for="password">Heslo</label>
            <input
               type="password"
               id="password"
               name="password"
               required
            >
         </div>

         <button type="submit">Přihlásit</button>

      </form>

   </body>
</html>
