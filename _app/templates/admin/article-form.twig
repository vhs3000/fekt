{% extends "base.twig" %}
{% block title %}
   Nový článek
{% endblock %}
{% block head %}
   <link rel="stylesheet" href="../../assets/editor/ckeditor5/ckeditor5.css">
{% endblock %}


{% block body %}
   <div class="container bg-white p-4 rounded-2">

      <nav class="d-flex justify-content-end">
         <a href="/admin" class="link-primary">Zpět na seznam článků</a>
      </nav>
      {% if isNew %}
         <h1>Nový článek</h1>
      {% else %}
         <h1>Editace článku</h1>
      {% endif %}

      {% if error %}
         <p>{{ error }}</p>
      {% endif %}

      <form
         id="article-form"
         method="post"
         action="{% if isNew %}/admin/articles/create{% else %}/admin/articles/edit{% endif %}"
      >

         {% if not isNew %}
            <input
               type="hidden"
               name="id"
               value="{{ article.id }}"
            >
         {% endif %}

         <div class="mb-3 container-320 bg-white">
            <label for="title" class="form-label">Nadpis</label>
            <input
               type="text"
               id="title"
               name="title"
               value="{{ article.title }}"
               class="form-control"
               required
            >
         </div>

         <div class="ck-wrapper mb-3">
            <label for="content" class="form-label">Obsah</label>
            <textarea
                id="editor"
                name="content"
                rows="10"
            >{{ article.content }}</textarea>
         </div>

         <div class="d-md-flex gap-3 mb-3">
            <label for="published_from" class="form-label my-md-auto">Platnost od</label>
            <input
               type="date"
               id="published_from"
               name="published_from"
               class="form-control w-auto mb-3 mb-md-auto"
               value="{{ article.published_from }}"
               required
            >
 
            <label for="published_to" class="form-label my-md-auto">Platnost do</label>
            <input
               type="date"
               id="published_to"
               name="published_to"
               class="form-control w-auto"
               value="{{ article.published_to }}"
            >
         </div>

         <div class="d-flex gap-3">
            <button type="submit" class="btn btn-success">
               {% if isNew %}
                  Vytvořit
               {% else %}
                  Uložit změny
               {% endif %}
            </button>
            <a href="/admin" class="btn btn-outline-dark">Zrušit</a>
         </div>


      </form>

   </div>

{% endblock %}

{% block documentEnd %}

   <script type="importmap">
		{
			"imports": {
				"ckeditor5": "../../assets/editor/ckeditor5/ckeditor5.js",
				"ckeditor5/": "../../assets/editor/ckeditor5/"
			}
		}
		</script>
   <script type="module" src="../../assets/editor/initArticleEditor.js"></script>
{% endblock %}

