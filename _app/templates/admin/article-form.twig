{% extends "base.twig" %}
{% block title %}
   Nový článek
{% endblock %}
{% block head %}
   <link rel="stylesheet" href="../../assets/editor/ckeditor5/ckeditor5.css">
{% endblock %}


{% block body %}
   {% if isNew %}
      <h1>Nový článek</h1>
   {% else %}
      <h1>Upravit článek</h1>
   {% endif %}

   {% if error %}
      <p>{{ error }}</p>
   {% endif %}

   <form
      id="article-form"
      method="post"
      action="{% if isNew %}/admin/articles/create{% else %}/admin/articles/edit{% endif %}"
   >

      {% if not isNew %}
         <input
            type="hidden"
            name="id"
            value="{{ article.id }}"
         >
      {% endif %}

      <div>
         <label for="title">Nadpis</label>
         <input
            type="text"
            id="title"
            name="title"
            value="{{ article.title }}"
            required
         >
      </div>

      <div>
         <label for="content">Obsah</label>
         <textarea
                id="editor"
                name="content"
                rows="10"
            >{{ article.content }}</textarea>
      </div>

      <div>
         <label for="published_from">Platí od</label>
         <input
            type="date"
            id="published_from"
            name="published_from"
            value="{{ article.published_from }}"
            required
         >
      </div>

      <div>
         <label for="published_to">Platí do</label>
         <input
            type="date"
            id="published_to"
            name="published_to"
            value="{{ article.published_to }}"
         >
      </div>

      <button type="submit">
         {% if isNew %}
            Vytvořit
         {% else %}
            Uložit změny
         {% endif %}
      </button>

   </form>

   <p>
      <a href="/admin">Zpět na seznam článků</a>
   </p>

{% endblock %}

{% block documentEnd %}

   <script type="importmap">
		{
			"imports": {
				"ckeditor5": "../../assets/editor/ckeditor5/ckeditor5.js",
				"ckeditor5/": "../../assets/editor/ckeditor5/"
			}
		}
		</script>
   <script type="module" src="../../js/initArticleEditor.js"></script>
{% endblock %}

