{% extends "base.twig" %}
{% block title %}
   Administrace 
{% endblock %}

{% block body %}
   <p>
      <a href="/admin/logout">Odhlásit</a>
   </p>
   <h1>Administrace článků</h1>
   <p>
      <a href="/admin/articles/create" class="btn btn-primary">Přidat článek</a>
   </p>


   {% if articles %}
      {% for article in articles %}
         <article class="border p-2 mb-3 row">
            <div class="col-md-6">

               <h2>{{ article.title }}</h2>



               <div>
                  {{ article.content|raw }}
               </div>
            </div>
            <div class="col-md-6">
               <p>
                  Platí od: {{ article.published_from }}

                  {% if article.published_to %}
                     <br>
                     Platí do: {{ article.published_to }}
                  {% endif %}
               </p>
               <div class="d-flex gap-2">

                  <a href="/admin/articles/edit?id={{ article.id }}" class="btn  btn-outline-primary">
                     Upravit
                  </a>
                  <form method="post" action="/admin/articles/delete">
                     <input type="hidden" name="id" value="{{ article.id }}">
                     <button type="submit" class="btn btn-danger">Smazat</button>
                  </form>
               </div>
            </div>
         </article>

   
      {% endfor %}
      {% include "pagination.twig" %}
   {% else %}
      <p>Žádné články.</p>
   {% endif %}

{% endblock %}
