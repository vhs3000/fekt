<!DOCTYPE html>
<html lang="cs">
   <head>
      <meta charset="UTF-8">
      <title>Administrace</title>
   </head>
   <body>

      <h1>Administrace článků</h1>
      <p>
         <a href="/admin/articles/create">Přidat článek</a>
      </p>
      <p>
         <a href="/admin/logout">Odhlásit</a>
      </p>

      {% if articles %}
         {% for article in articles %}
            <article>
               <h2>{{ article.title }}</h2>

               <p>
                  Platí od: {{ article.published_from }}

                  {% if article.published_to %}
                     <br>
                     Platí do: {{ article.published_to }}
                  {% endif %}
               </p>

               <div>
                  {{ article.content|raw }}
               </div>
               <a href="/admin/articles/edit?id={{ article.id }}">
                  Upravit
               </a>
               <form method="post" action="/admin/articles/delete">
                  <input type="hidden" name="id" value="{{ article.id }}">
                  <button type="submit">Smazat</button>
               </form>
            </article>

            <hr>
         {% endfor %}
      {% else %}
         <p>Žádné články.</p>
      {% endif %}

   </body>
</html>
