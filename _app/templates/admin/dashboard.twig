{% extends "base.twig" %}
{% block title %}
   Administrace 
{% endblock %}

{% block body %}
   <div class="container bg-white p-4 rounded-2">
      <nav class="d-flex justify-content-end gap-3 mb-3">
         <a href="/" class="link-primary" target="_blank">Náhled</a>
         <a href="/admin/logout" class="link-primary">Odhlásit<i class="fa-solid fa-sign-out ms-1"></i></a>
      </nav>

      <div class="d-flex gap-4">
         <h1>Administrace článků</h1>
         <p>
            <a href="/admin/articles/create" class="btn btn-primary">
               <i class="fa-solid fa-file-circle-plus h2"></i>
               Přidat článek</a>
         </p>
      </div>

      {% if articles %}
         {% for article in articles %}
            <article class="border px-2 pt-3 pb-4 mb-3 row">
               <div class="col-md-6 col-lg-8">

                  <h2 class="h4">{{ article.title }}</h2>



                  <div class="dashboard-preview">
                     {{ article.content|raw }}
                  </div>
               </div>
               <div class="col-md-6 col-lg-4">
                  <p>
                     Platí od: {{ article.published_from }}

                     {% if article.published_to %}
                        <br>
                        Platí do: {{ article.published_to }}
                     {% endif %}
                  </p>
                  <div class="d-flex gap-2">

                     <a href="/admin/articles/edit?id={{ article.id }}" class="btn  btn-outline-primary">
                        <i class="fa-solid fa-pen"></i>
                        Upravit
                     </a>
                     <form method="post" action="/admin/articles/delete">
                        <input type="hidden" name="id" value="{{ article.id }}">
                        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                        {# <button type="submit" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i>Smazat</button> #}
                        
                        <button
                           type="button"
                           class="btn btn-danger"
                           data-bs-toggle="modal"
                           data-bs-target="#deleteModal"
                           data-article-title="{{ article.title }}"
                        >
                           <i class="fa-solid fa-trash me-1"></i>
                           Smazat
                        </button>
                     </form>
                  </div>
               </div>
            </article>

   
         {% endfor %}
         {% include "pagination.twig" %}
      {% else %}
         <p>Žádné články.</p>
      {% endif %}
   </div>

   <div
      class="modal fade"
      id="deleteModal"
      tabindex="-1"
      aria-labelledby="deleteModalLabel"
      aria-hidden="true"
   >
      <div class="modal-dialog">
         <div class="modal-content">

            <div class="modal-header">
               <h2 class="modal-title fs-5" id="deleteModalLabel">
                  Smazat článek?
               </h2>

               <button
                  type="button"
                  class="btn-close"
                  data-bs-dismiss="modal"
                  aria-label="Zavřít"
               ></button>
            </div>

            <div class="modal-body">
               Opravdu chcete smazat článek
               <strong id="deleteArticleTitle"></strong>?
            </div>

            <div class="modal-footer">
               <button
                  type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal"
               >
                  Zrušit
               </button>

               <button
                  type="button"
                  class="btn btn-danger"
                  id="confirmDelete"
               >
                  <i class="fa-solid fa-trash me-1"></i>
                  Smazat
               </button>
            </div>

         </div>
      </div>
   </div>
{% endblock %}

{% block documentEnd %}

   <script>
      const deleteModal = document.querySelector("#deleteModal");

      if (deleteModal) {
         let formToSubmit = null;

         deleteModal.addEventListener("show.bs.modal", (event) => {
            const button = event.relatedTarget;

            formToSubmit = button.closest("form");

            const articleTitle = button.dataset.articleTitle;

            document.querySelector("#deleteArticleTitle").textContent = articleTitle;
         });

         document.querySelector("#confirmDelete").addEventListener("click", () => {
            if (formToSubmit) {
               formToSubmit.submit();
            }
         });
      }
   </script>

   <script src="../../assets/js-bootstrap-5-3/bootstrap.min.js"></script>
{% endblock %}
