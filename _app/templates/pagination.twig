{% if pagination.totalPages > 1 %}

   {% set currentPage = pagination.currentPage %}
   {% set totalPages = pagination.totalPages %}

   {# Kolik číselných stránek chceme zobrazovat #}
   {% set visiblePages = 7 %}

   <nav aria-label="Stránkování" class="mx-auto my-3">
      <ul class="pagination justify-content-center">

         {# Předchozí #}
         {% if currentPage > 1 %}
            <li class="page-item">
               <a
                  href="?page={{ currentPage - 1 }}"
                  aria-label="Předchozí stránka"
                  class="page-link"
               >
                  &laquo;
               </a>
            </li>
         {% endif %}


         {# Stránky #}

         {% if totalPages <= visiblePages %}

            {# Málo stránek – zobrazíme všechny #}
            {% for page in 1..totalPages %}
               <li class="page-item{% if page == currentPage %} active{% endif %}">
                  {% if page == currentPage %}
                     <span
                        class="page-link"
                        aria-current="page"
                        aria-label="Stránka {{ page }}, aktuální stránka"
                     >
                        {{ page }}
                     </span>
                  {% else %}
                     <a
                        href="?page={{ page }}"
                        class="page-link"
                        aria-label="Stránka {{ page }}"
                     >
                        {{ page }}
                     </a>
                  {% endif %}
               </li>
            {% endfor %}


         {% elseif currentPage <= 4 %}

            {# Začátek #}
            {% for page in 1..visiblePages %}
               <li class="page-item{% if page == currentPage %} active{% endif %}">
                  {% if page == currentPage %}
                     <span
                        class="page-link"
                        aria-current="page"
                        aria-label="Stránka {{ page }}, aktuální stránka"
                     >
                        {{ page }}
                     </span>
                  {% else %}
                     <a
                        href="?page={{ page }}"
                        class="page-link"
                        aria-label="Stránka {{ page }}"
                     >
                        {{ page }}
                     </a>
                  {% endif %}
               </li>
            {% endfor %}

            <li class="page-item">
               <span class="page-link" aria-hidden="true">…</span>
            </li>

            <li class="page-item">
               <a
                  href="?page={{ totalPages }}"
                  class="page-link"
                  aria-label="Stránka {{ totalPages }}"
               >
                  {{ totalPages }}
               </a>
            </li>


         {% elseif currentPage >= totalPages - 3 %}

            {# Konec #}
            <li class="page-item">
               <a
                  href="?page=1"
                  class="page-link"
                  aria-label="Stránka 1"
               >
                  1
               </a>
            </li>

            <li class="page-item">
               <span class="page-link" aria-hidden="true">…</span>
            </li>

            {% for page in (totalPages - visiblePages + 1)..totalPages %}
               <li class="page-item{% if page == currentPage %} active{% endif %}">
                  {% if page == currentPage %}
                     <span
                        class="page-link"
                        aria-current="page"
                        aria-label="Stránka {{ page }}, aktuální stránka"
                     >
                        {{ page }}
                     </span>
                  {% else %}
                     <a
                        href="?page={{ page }}"
                        class="page-link"
                        aria-label="Stránka {{ page }}"
                     >
                        {{ page }}
                     </a>
                  {% endif %}
               </li>
            {% endfor %}


         {% else %}

            {# Uprostřed #}
            <li class="page-item">
               <a
                  href="?page=1"
                  class="page-link"
                  aria-label="Stránka 1"
               >
                  1
               </a>
            </li>

            <li class="page-item">
               <span class="page-link" aria-hidden="true">…</span>
            </li>

            {% for page in (currentPage - 3)..(currentPage + 3) %}
               <li class="page-item{% if page == currentPage %} active{% endif %}">
                  {% if page == currentPage %}
                     <span
                        class="page-link"
                        aria-current="page"
                        aria-label="Stránka {{ page }}, aktuální stránka"
                     >
                        {{ page }}
                     </span>
                  {% else %}
                     <a
                        href="?page={{ page }}"
                        class="page-link"
                        aria-label="Stránka {{ page }}"
                     >
                        {{ page }}
                     </a>
                  {% endif %}
               </li>
            {% endfor %}

            <li class="page-item">
               <span class="page-link" aria-hidden="true">…</span>
            </li>

            <li class="page-item">
               <a
                  href="?page={{ totalPages }}"
                  class="page-link"
                  aria-label="Stránka {{ totalPages }}"
               >
                  {{ totalPages }}
               </a>
            </li>

         {% endif %}


         {# Následující #}
         {% if currentPage < totalPages %}
            <li class="page-item">
               <a
                  href="?page={{ currentPage + 1 }}"
                  aria-label="Následující stránka"
                  class="page-link"
               >
                  &raquo;
               </a>
            </li>
         {% endif %}

      </ul>
   </nav>

{% endif %}
